{
  "name": "balajee-trading-centre-site",
  "version": "1.0.0",
  "private": true,
  "description": "Mobile-first marketing website and WhatsApp quote builder for M/S Balajee Trading Centre, Siliguri.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/preview.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "screenshots": "playwright test --config playwright.screenshots.config.ts",
    "verify": "npm run typecheck && npm run lint && npm run test:unit && npm run build && npm run test:e2e",
    "test:unit": "node scripts/test-unit.mjs"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "0.27.7",
    "playwright": "1.56.1",
    "typescript": "^6.0.2",
    "@types/node": "^25.6.2"
  }
}
