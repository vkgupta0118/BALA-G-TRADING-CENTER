# Copy this file to `.env` (or `.env.production`) and fill in VERIFIED values only.
# Only variables prefixed with PUBLIC_ are exposed to the browser bundle.
# Never put secrets here – everything below ships to the client.

# --- REQUIRED before going live -------------------------------------------
# WhatsApp Business number in E.164 digits ONLY (country code + number, no +, spaces or dashes).
# Example for an Indian mobile: 919XXXXXXXXX. Leave empty until the owner confirms the number.
PUBLIC_WHATSAPP_E164=

# Click-to-call number in E.164 digits. If empty, the Call buttons fall back to PUBLIC_WHATSAPP_E164.
PUBLIC_PHONE_E164=

# Public https URL of the deployed site, no trailing slash. Used for canonical URLs, Open Graph, sitemap.xml and robots.txt.
PUBLIC_SITE_URL=

# Sub-path when hosted under a folder, e.g. /REPO-NAME on a GitHub Pages project site. Leave empty for a custom domain root.
PUBLIC_BASE_PATH=

# --- Business facts (only set after the owner has verified them) ----------
# Final legal/trading name exactly as it should appear on the site and on Google Business Profile.
PUBLIC_BUSINESS_NAME=M/S Balajee Trading Centre

# Google Maps share link for the Directions buttons.
PUBLIC_MAPS_URL=https://maps.app.goo.gl/9FQnudyceXPjySFi7

# Set to "true" ONLY after the owner confirms which brands the shop actually stocks (see src/config/site.ts).
PUBLIC_SHOW_BRANDS=false

# Set to "true" ONLY after the owner confirms a delivery service and its areas (see src/config/site.ts).
PUBLIC_DELIVERY_VERIFIED=false

# Set to "true" ONLY after the owner confirms the business hours in src/config/site.ts are correct.
PUBLIC_HOURS_VERIFIED=false

# Contact email for privacy questions / enquiries (optional; shown in the footer + privacy notice when set).
PUBLIC_CONTACT_EMAIL=

# --- Analytics (all optional, all off by default) -------------------------
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
PUBLIC_GA4_MEASUREMENT_ID=
# Google Ads conversion ID, e.g. AW-XXXXXXXXX (used for conversion events only)
PUBLIC_GOOGLE_ADS_ID=
# Meta (Facebook) Pixel ID
PUBLIC_META_PIXEL_ID=
